module

public import InfoTheoryLib.IMeasure.SignedMeasure
public import InfoTheoryLib.MutualInformation.Block

/-!
# The I-Measure

The I-Measure `μ*` of random variables `Xᵢ`, `i ∈ ι`, is the signed measure on the field generated
by sets `X̃ᵢ` with `μ*(X̃_G) = H(X_G)` for all `G`. It turns Shannon's information measures into a
signed measure, through the substitution `H, I ↔ μ*`, `, ↔ ∪`, `; ↔ ∩`, `| ↔ -`.

## Main definitions

* `iMeasure μ X`: the I-Measure `μ*`.

## Main statements

* `iMeasure_tilde`: `μ*(X̃_G) = H(X_G)`.
* `iMeasure_inter_sdiff`: `μ*(X̃_G ∩ X̃_G' - X̃_G'') = I(X_G; X_G' | X_G'')`.
* `eq_iMeasure_of_consistent`: `μ*` is the only signed measure consistent with Shannon's
  information measures.
* `iMeasure_inter_inter_sdiff`: `I(X; Y; T | Z) = I(X; Y | Z) - I(X; Y | Z, T)`.
* `iMeasure_atom_singleton`, `iMeasure_atom_pair`: the values on the atoms with one or two positive
  indices, which are nonnegative (`iMeasure_atom_nonneg`).

## Implementation notes

The value of `μ*` on an intersection of three or more sets, written `I(X₁; X₂; X₃)` in the book, is
not given a separate name: it is `iMeasure μ X (tilde G₁ ∩ tilde G₂ ∩ tilde G₃)`.

## References

* [R. W. Yeung, *Information Theory and Network Coding*][yeung2008], Sections 3.2 to 3.5
-/

open Real Finset

@[expose] public noncomputable section

namespace InfoTheory

variable {Ω : Type*} [Fintype Ω] {ι : Type*} [Fintype ι] [DecidableEq ι] {A : ι → Type*}
  [∀ i, Fintype (A i)] {β γ δ κ : Type*}

/-- **(3.40)** The I-Measure `μ*` of the random variables `Xᵢ`: the signed measure with
`μ*(X̃_G) = H(X_G)` for all `G`. -/
def iMeasure (μ : Ω → ℝ) (X : ∀ i, Ω → A i) : Finset (NAtom ι) → ℝ :=
  signedMeasureOf (blockEntropy μ X)

variable {μ : Ω → ℝ} {X : ∀ i, Ω → A i}

/-- `μ*` is a signed measure on the field generated by the sets `X̃ᵢ`. -/
theorem isSignedMeasure_iMeasure (μ : Ω → ℝ) (X : ∀ i, Ω → A i) :
    IsSignedMeasure (iMeasure μ X) :=
  isSignedMeasure_signedMeasureOf _

/-- **(3.40), (3.44)** `μ*(X̃_G) = H(X_G)`. -/
theorem iMeasure_tilde (hμ : IsPMF μ) (G : Finset ι) :
    iMeasure μ X (tilde G) = H[blockRV X G ; μ] :=
  signedMeasureOf_tilde (blockEntropy_empty hμ) G

/-- **(3.41)** `μ*(X̃_G ∩ X̃_G' - X̃_G'') = I(X_G; X_G' | X_G'')`, for random variables `U`, `V`,
`W` that are equivalent to `X_G`, `X_G'`, `X_G''`. -/
theorem iMeasure_inter_sdiff [Fintype β] [Fintype γ] [Fintype δ] (hμ : IsPMF μ) {U : Ω → β}
    {V : Ω → γ} {W : Ω → δ} {G G' G'' : Finset ι} (hU : RVEquiv U (blockRV X G))
    (hV : RVEquiv V (blockRV X G')) (hW : RVEquiv W (blockRV X G'')) :
    iMeasure μ X ((tilde G ∩ tilde G') \ tilde G'') = I[U : V | W ; μ] := by
  have hm := isSignedMeasure_iMeasure μ X
  rw [hm.inter_sdiff_eq_union, condMutualInfo_eq_blockEntropy hμ hU hV hW, ← tilde_union,
    ← tilde_union, ← tilde_union, ← tilde_union, iMeasure_tilde hμ, iMeasure_tilde hμ,
    iMeasure_tilde hμ, iMeasure_tilde hμ]
  simp only [blockEntropy]
  rw [union_comm G G'', union_comm G' G'', union_comm (G ∪ G') G'']
  ring

/-- **(3.41)** `μ*(X̃_G ∩ X̃_G' - X̃_G'') = I(X_G; X_G' | X_G'')`. -/
theorem iMeasure_consistent (hμ : IsPMF μ) (G G' G'' : Finset ι) :
    iMeasure μ X ((tilde G ∩ tilde G') \ tilde G'') =
      I[blockRV X G : blockRV X G' | blockRV X G'' ; μ] :=
  iMeasure_inter_sdiff hμ (RVEquiv.refl _) (RVEquiv.refl _) (RVEquiv.refl _)

/-- **(3.42)** `μ*(X̃_G ∩ X̃_G') = I(X_G; X_G')`. -/
theorem iMeasure_inter [Fintype β] [Fintype γ] (hμ : IsPMF μ) {U : Ω → β} {V : Ω → γ}
    {G G' : Finset ι} (hU : RVEquiv U (blockRV X G)) (hV : RVEquiv V (blockRV X G')) :
    iMeasure μ X (tilde G ∩ tilde G') = I[U : V ; μ] := by
  have h := iMeasure_inter_sdiff (G'' := ∅) hμ hU hV (RVEquiv.refl _)
  rwa [tilde_empty, sdiff_empty, blockRV_empty, condMutualInfo_const hμ] at h

/-- **(3.43)** `μ*(X̃_G - X̃_G'') = H(X_G | X_G'')`. -/
theorem iMeasure_sdiff [Fintype β] [Fintype δ] (hμ : IsPMF μ) {U : Ω → β} {W : Ω → δ}
    {G G'' : Finset ι} (hU : RVEquiv U (blockRV X G)) (hW : RVEquiv W (blockRV X G'')) :
    iMeasure μ X (tilde G \ tilde G'') = H[U | W ; μ] := by
  have h := iMeasure_inter_sdiff hμ hU hU hW
  rwa [inter_self, condMutualInfo_self hμ] at h

/-- **Theorem 3.9, uniqueness.** A signed measure consistent with Shannon's information measures, in
the sense of (3.41), is `μ*`. -/
theorem eq_iMeasure_of_consistent (hμ : IsPMF μ) {m : Finset (NAtom ι) → ℝ}
    (hm : IsSignedMeasure m)
    (h : ∀ G G' G'' : Finset ι, G.Nonempty → G'.Nonempty → m ((tilde G ∩ tilde G') \ tilde G'') =
      I[blockRV X G : blockRV X G' | blockRV X G'' ; μ]) : m = iMeasure μ X := by
  refine hm.eq_signedMeasureOf (blockEntropy_empty hμ) fun G hG => ?_
  have h' := h G G ∅ hG hG
  rwa [inter_self, tilde_empty, sdiff_empty, condMutualInfo_self hμ, blockRV_empty,
    condEntropy_const hμ] at h'

/-- **(3.64), (3.70), (3.82)** `I(X; Y; T | Z) = I(X; Y | Z) - I(X; Y | Z, T)`. -/
theorem iMeasure_inter_inter_sdiff [Fintype β] [Fintype γ] [Fintype δ] [Fintype κ] (hμ : IsPMF μ)
    {U : Ω → β} {V : Ω → γ} {W : Ω → δ} {W' : Ω → κ} {G G' F T : Finset ι}
    (hU : RVEquiv U (blockRV X G)) (hV : RVEquiv V (blockRV X G'))
    (hW : RVEquiv W (blockRV X F)) (hW' : RVEquiv W' (blockRV X (F ∪ T))) :
    iMeasure μ X ((tilde G ∩ tilde G' ∩ tilde T) \ tilde F) =
      I[U : V | W ; μ] - I[U : V | W' ; μ] := by
  rw [(isSignedMeasure_iMeasure μ X).inter_inter_sdiff_eq, iMeasure_inter_sdiff hμ hU hV hW,
    ← tilde_union, iMeasure_inter_sdiff hμ hU hV hW']

section Atoms

omit [Fintype ι] [DecidableEq ι] in
/-- A set is the singleton of an atom if its members are the atoms with the same indices. -/
lemma singleton_eq_of_forall {S : NAtom ι} {F : Finset (NAtom ι)}
    (h : ∀ a : NAtom ι, a ∈ F ↔ ∀ i, i ∈ a.1 ↔ i ∈ S.1) : ({S} : Finset (NAtom ι)) = F := by
  ext a
  rw [mem_singleton, h]
  constructor
  · rintro rfl i
    rfl
  · exact fun h' => Subtype.ext (Finset.ext h')

/-- An atom with one positive index is `X̃ᵢ - X̃_{{i}ᶜ}`. -/
lemma singleton_atom_singleton (i : ι) :
    ({⟨{i}, singleton_nonempty i⟩} : Finset (NAtom ι)) = tilde {i} \ tilde {i}ᶜ := by
  refine singleton_eq_of_forall fun a => ?_
  simp only [mem_sdiff, mem_tilde, mem_singleton, exists_eq_left, mem_compl, not_exists, not_and]
  constructor
  · rintro ⟨h₁, h₂⟩ k
    constructor
    · intro hk
      by_contra hne
      exact h₂ k hne hk
    · rintro rfl
      exact h₁
  · intro h
    exact ⟨(h i).2 rfl, fun k hne hk => hne ((h k).1 hk)⟩

/-- An atom with two positive indices is `X̃ᵢ ∩ X̃ⱼ - X̃_{{i, j}ᶜ}`. -/
lemma singleton_atom_pair (i j : ι) :
    ({⟨{i, j}, insert_nonempty i _⟩} : Finset (NAtom ι)) =
      (tilde {i} ∩ tilde {j}) \ tilde {i, j}ᶜ := by
  refine singleton_eq_of_forall fun a => ?_
  simp only [mem_sdiff, mem_inter, mem_tilde, mem_singleton, exists_eq_left, mem_compl, mem_insert,
    not_exists, not_and, not_or]
  constructor
  · rintro ⟨⟨hi, hj⟩, h₂⟩ k
    constructor
    · intro hk
      by_contra hne
      exact h₂ k (not_or.1 hne) hk
    · rintro (rfl | rfl)
      · exact hi
      · exact hj
  · intro h
    exact ⟨⟨(h i).2 (Or.inl rfl), (h j).2 (Or.inr rfl)⟩,
      fun k hne hk => (not_or.2 hne) ((h k).1 hk)⟩

/-- An atom with three positive indices is `X̃ᵢ ∩ X̃ⱼ ∩ X̃ₖ - X̃_{{i, j, k}ᶜ}`. -/
lemma singleton_atom_triple (i j k : ι) :
    ({⟨{i, j, k}, insert_nonempty i _⟩} : Finset (NAtom ι)) =
      (tilde {i} ∩ tilde {j} ∩ tilde {k}) \ tilde {i, j, k}ᶜ := by
  refine singleton_eq_of_forall fun a => ?_
  simp only [mem_sdiff, mem_inter, mem_tilde, mem_singleton, exists_eq_left, mem_compl, mem_insert,
    not_exists, not_and, not_or]
  constructor
  · rintro ⟨⟨⟨hi, hj⟩, hk⟩, h₂⟩ l
    constructor
    · intro hl
      by_contra hne
      rw [not_or, not_or] at hne
      exact h₂ l ⟨hne.1, hne.2⟩ hl
    · rintro (rfl | rfl | rfl)
      · exact hi
      · exact hj
      · exact hk
  · intro h
    refine ⟨⟨⟨(h i).2 (Or.inl rfl), (h j).2 (Or.inr (Or.inl rfl))⟩,
      (h k).2 (Or.inr (Or.inr rfl))⟩, fun l hne hl => ?_⟩
    rcases (h l).1 hl with h' | h' | h'
    · exact hne.1 h'
    · exact hne.2.1 h'
    · exact hne.2.2 h'

/-- **(3.51)** The value of `μ*` on the atom `X̃ᵢ - X̃_{{i}ᶜ}` is `H(Xᵢ | X_{{i}ᶜ})`. -/
theorem iMeasure_atom_singleton (hμ : IsPMF μ) (i : ι) :
    iMeasure μ X {⟨{i}, singleton_nonempty i⟩} = H[X i | blockRV X {i}ᶜ ; μ] := by
  rw [singleton_atom_singleton]
  exact iMeasure_sdiff hμ (rvEquiv_blockRV_singleton X i) (RVEquiv.refl _)

/-- **(3.52)** The value of `μ*` on the atom `X̃ᵢ ∩ X̃ⱼ - X̃_{{i, j}ᶜ}` is
`I(Xᵢ; Xⱼ | X_{{i, j}ᶜ})`. -/
theorem iMeasure_atom_pair (hμ : IsPMF μ) (i j : ι) :
    iMeasure μ X {⟨{i, j}, insert_nonempty i _⟩} = I[X i : X j | blockRV X {i, j}ᶜ ; μ] := by
  rw [singleton_atom_pair]
  exact iMeasure_inter_sdiff hμ (rvEquiv_blockRV_singleton X i) (rvEquiv_blockRV_singleton X j)
    (RVEquiv.refl _)

/-- **Section 3.4.** `μ*` is nonnegative on the atoms with at most two positive indices, as its
values there are Shannon's information measures. -/
theorem iMeasure_atom_nonneg (hμ : IsPMF μ) (S : NAtom ι) (hS : #S.1 ≤ 2) :
    0 ≤ iMeasure μ X {S} := by
  obtain ⟨S, hne⟩ := S
  have hpos : 0 < #S := card_pos.2 hne
  have hS' : #S ≤ 2 := hS
  rcases (by omega : #S = 1 ∨ #S = 2) with h | h
  · obtain ⟨i, rfl⟩ := card_eq_one.1 h
    rw [iMeasure_atom_singleton hμ]
    exact condEntropy_nonneg hμ _ _
  · obtain ⟨i, j, -, rfl⟩ := card_eq_two.1 h
    rw [iMeasure_atom_pair hμ]
    exact condMutualInfo_nonneg hμ _ _ _

/-- **Section 3.4.** For two random variables, `μ*` is nonnegative. -/
theorem iMeasure_nonneg_of_card_two (hι : Fintype.card ι = 2) (hμ : IsPMF μ)
    (F : Finset (NAtom ι)) : 0 ≤ iMeasure μ X F := by
  rw [(isSignedMeasure_iMeasure μ X).eq_sum_singleton F]
  refine sum_nonneg fun a _ => iMeasure_atom_nonneg hμ a ?_
  rw [← hι]
  exact card_le_univ _

/-- Lemma 3.7 for `μ*`, in terms of the entropies of index sets. -/
theorem iMeasure_inter_sdiff_eq_blockEntropy (hμ : IsPMF μ) {G G' F U₁ U₂ U₃ : Finset ι}
    (h₁ : G ∪ F = U₁) (h₂ : G' ∪ F = U₂) (h₃ : G ∪ G' ∪ F = U₃) :
    iMeasure μ X ((tilde G ∩ tilde G') \ tilde F) =
      blockEntropy μ X U₁ + blockEntropy μ X U₂ - blockEntropy μ X U₃ - blockEntropy μ X F := by
  rw [(isSignedMeasure_iMeasure μ X).inter_sdiff_eq_union, ← tilde_union, ← tilde_union,
    ← tilde_union, ← tilde_union, h₁, h₂, h₃, iMeasure_tilde hμ, iMeasure_tilde hμ,
    iMeasure_tilde hμ, iMeasure_tilde hμ]
  rfl

end Atoms

end InfoTheory
