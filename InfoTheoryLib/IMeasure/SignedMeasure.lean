module

public import Mathlib

/-!
# Signed measures on the field generated by `n` sets

The field `Fₙ` generated by sets `X̃₁, …, X̃ₙ` in general position is the free Boolean algebra on
them. We model it by its atoms. An atom is the intersection of the `X̃ᵢ` with `i ∈ S` and of the
complements of the others, so atoms correspond to subsets `S` of the indices, and a set of the
field is a set of atoms. With the universal set `X̃₁ ∪ ⋯ ∪ X̃ₙ`, the atom of `S = ∅` is empty, so
the atoms that remain are the nonempty subsets of the indices, `NAtom ι`.

## Main definitions

* `baseSet φ i`: the set `X̃ᵢ`, for atoms `a` labelled by subsets `φ a` of the indices.
* `IsSignedMeasure m`: `m` is additive on disjoint sets.
* `NAtom ι`: the nonempty atoms.
* `tilde G`: the set `X̃_G = ⋃_{i ∈ G} X̃ᵢ`.
* `atomValue h S`: the value on the atom `S` of the signed measure with `μ(X̃_G) = h G`.
* `signedMeasureOf h`: that signed measure.

## Main statements

* `closure_range_baseSet`: the sets `X̃ᵢ` generate the field.
* `IsSignedMeasure.inter_sdiff_eq_union`:
  `μ(A ∩ B - C) = μ(A ∪ C) + μ(B ∪ C) - μ(A ∪ B ∪ C) - μ(C)`.
* `IsSignedMeasure.inf_sdiff_eq_sum`: the variation of the inclusion-exclusion formula.
* `existsUnique_isSignedMeasure_tilde`: a signed measure is determined by its values on the sets
  `X̃_G`, which can be any real numbers.

## References

* [R. W. Yeung, *Information Theory and Network Coding*][yeung2008], Sections 3.1 and 3.3 and
  Appendix 3.A
-/

open Finset

@[expose] public noncomputable section

namespace InfoTheory

section Generators

variable {α ι : Type*} [Fintype α] [DecidableEq α] [Fintype ι] [DecidableEq ι]

/-- The set `X̃ᵢ` of the atoms containing `i`, for atoms `a` labelled by subsets `φ a` of the
indices. -/
def baseSet (φ : α → Finset ι) (i : ι) : Finset α := univ.filter fun a => i ∈ φ a

omit [DecidableEq α] [Fintype ι] in
lemma mem_baseSet {φ : α → Finset ι} {i : ι} {a : α} : a ∈ baseSet φ i ↔ i ∈ φ a := by
  simp [baseSet]

/-- **Definition 3.2.** An atom is an intersection of the `X̃ᵢ` and of their complements. -/
theorem singleton_eq_inf_baseSet {φ : α → Finset ι} (hφ : Function.Injective φ) (a : α) :
    ({a} : Finset α) =
      univ.inf fun i => if i ∈ φ a then baseSet φ i else (baseSet φ i)ᶜ := by
  ext b
  simp only [mem_singleton, Finset.mem_inf, mem_univ, forall_const]
  constructor
  · rintro rfl i
    split_ifs with h
    · exact mem_baseSet.2 h
    · simpa [mem_baseSet] using h
  · intro h
    refine hφ (Finset.ext fun i => ?_)
    have hi := h i
    by_cases hia : i ∈ φ a
    · simp only [hia, ↓reduceIte, mem_baseSet] at hi
      exact iff_of_true hi hia
    · simp only [hia, ↓reduceIte, mem_compl, mem_baseSet] at hi
      exact iff_of_false hi hia

omit [Fintype ι] in
/-- **Definition 3.1.** The sets `X̃ᵢ` generate the field, so that every set of atoms is in the
field they generate. -/
theorem closure_range_baseSet [Finite ι] {φ : α → Finset ι} (hφ : Function.Injective φ) :
    BooleanSubalgebra.closure (Set.range (baseSet φ)) = ⊤ := by
  have := Fintype.ofFinite ι
  refine eq_top_iff.2 fun A _ => ?_
  induction A using Finset.induction_on with
  | empty => exact BooleanSubalgebra.bot_mem
  | insert a s _ ih =>
    rw [insert_eq]
    refine BooleanSubalgebra.sup_mem ?_ (ih trivial)
    rw [singleton_eq_inf_baseSet hφ a]
    refine Finset.inf_induction (p := (· ∈ BooleanSubalgebra.closure (Set.range (baseSet φ))))
      BooleanSubalgebra.top_mem (fun _ h₁ _ h₂ => BooleanSubalgebra.inf_mem h₁ h₂)
      fun i _ => ?_
    have hmem : baseSet φ i ∈ BooleanSubalgebra.closure (Set.range (baseSet φ)) :=
      BooleanSubalgebra.subset_closure ⟨i, rfl⟩
    split_ifs
    · exact hmem
    · exact BooleanSubalgebra.compl_mem hmem

end Generators

section SignedMeasure

variable {α : Type*} [DecidableEq α]

/-- **Definition 3.4.** A real function on a field is a signed measure if it is additive on disjoint
sets, (3.2). -/
def IsSignedMeasure (m : Finset α → ℝ) : Prop :=
  ∀ A B, Disjoint A B → m (A ∪ B) = m A + m B

/-- A function on the atoms gives a signed measure. -/
theorem isSignedMeasure_sum (u : α → ℝ) : IsSignedMeasure fun A => ∑ a ∈ A, u a :=
  fun _ _ h => sum_union h

namespace IsSignedMeasure

variable {m : Finset α → ℝ}

/-- **(3.3)** `μ(∅) = 0`. -/
theorem map_empty (hm : IsSignedMeasure m) : m ∅ = 0 := by
  simpa using hm ∅ ∅ (by simp)

/-- A signed measure is specified by its values on the atoms. -/
theorem eq_sum_singleton (hm : IsSignedMeasure m) (A : Finset α) : m A = ∑ a ∈ A, m {a} := by
  induction A using Finset.induction_on with
  | empty => simpa using hm.map_empty
  | insert a s ha ih =>
    rw [sum_insert ha, ← ih, insert_eq, hm _ _ (disjoint_singleton_left.2 ha)]

/-- **(3.6)–(3.7).** `μ(A) = μ(A ∩ B) + μ(A - B)`. -/
theorem eq_inter_add_sdiff (hm : IsSignedMeasure m) (A B : Finset α) :
    m A = m (A ∩ B) + m (A \ B) := by
  rw [← hm _ _ (disjoint_sdiff_inter A B).symm, union_comm, sdiff_union_inter]

/-- **(3.29)** `μ(A - B) = μ(A ∪ B) - μ(B)`. -/
theorem sdiff_eq (hm : IsSignedMeasure m) (A B : Finset α) : m (A \ B) = m (A ∪ B) - m B := by
  have h := hm (A \ B) B sdiff_disjoint
  rw [sdiff_union_self_eq_union] at h
  linarith

/-- **(3.28)** `μ(A ∩ B - C) = μ(A - C) + μ(B - C) - μ(A ∪ B - C)`. -/
theorem inter_sdiff_eq (hm : IsSignedMeasure m) (A B C : Finset α) :
    m ((A ∩ B) \ C) = m (A \ C) + m (B \ C) - m ((A ∪ B) \ C) := by
  have h₁ := hm.eq_inter_add_sdiff (A \ C) (B \ C)
  have h₂ := hm.eq_inter_add_sdiff ((A ∪ B) \ C) (B \ C)
  have e₁ : A \ C ∩ (B \ C) = (A ∩ B) \ C := by
    ext a; simp only [mem_inter, mem_sdiff]; tauto
  have e₂ : (A ∪ B) \ C ∩ (B \ C) = B \ C := by
    ext a; simp only [mem_inter, mem_sdiff, mem_union]; tauto
  have e₃ : ((A ∪ B) \ C) \ (B \ C) = (A \ C) \ (B \ C) := by
    ext a; simp only [mem_sdiff, mem_union]; tauto
  rw [e₁] at h₁
  rw [e₂, e₃] at h₂
  linarith

/-- **Lemma 3.7.** `μ(A ∩ B - C) = μ(A ∪ C) + μ(B ∪ C) - μ(A ∪ B ∪ C) - μ(C)`. -/
theorem inter_sdiff_eq_union (hm : IsSignedMeasure m) (A B C : Finset α) :
    m ((A ∩ B) \ C) = m (A ∪ C) + m (B ∪ C) - m (A ∪ B ∪ C) - m C := by
  rw [hm.inter_sdiff_eq, hm.sdiff_eq, hm.sdiff_eq, hm.sdiff_eq]
  ring

/-- `μ(A ∩ B - C) - μ(A ∩ B - C - D) = μ(A ∩ B ∩ D - C)`: this is how the value of a signed measure
on an intersection of more sets reduces to one on fewer sets, as in (3.64). -/
theorem inter_inter_sdiff_eq (hm : IsSignedMeasure m) (A B C D : Finset α) :
    m ((A ∩ B ∩ D) \ C) = m ((A ∩ B) \ C) - m ((A ∩ B) \ (C ∪ D)) := by
  have h := hm.eq_inter_add_sdiff ((A ∩ B) \ C) D
  have e₁ : (A ∩ B) \ C ∩ D = (A ∩ B ∩ D) \ C := by
    ext a; simp only [mem_inter, mem_sdiff]; tauto
  have e₂ : ((A ∩ B) \ C) \ D = (A ∩ B) \ (C ∪ D) := by
    ext a; simp only [mem_sdiff, mem_union]; tauto
  rw [e₁, e₂] at h
  linarith

end IsSignedMeasure

/-- The alternating sum over the nonempty subsets of `s`. -/
lemma sum_powerset_nonempty_neg_one_pow {κ : Type*} [DecidableEq κ] (s : Finset κ) :
    ∑ T ∈ s.powerset with T.Nonempty, (-1 : ℝ) ^ (#T + 1) = if s = ∅ then 0 else 1 := by
  have h : ∑ T ∈ s.powerset, (-1 : ℝ) ^ #T = if s = ∅ then 1 else 0 := by
    have := congrArg (Int.cast : ℤ → ℝ) (Finset.sum_powerset_neg_one_pow_card (x := s))
    push_cast at this
    rw [this]
  have hsplit := sum_filter_add_sum_filter_not s.powerset (fun T => T.Nonempty)
    (fun T => (-1 : ℝ) ^ #T)
  have hempty : ∑ T ∈ s.powerset with ¬ T.Nonempty, (-1 : ℝ) ^ #T = 1 := by
    have e : s.powerset.filter (fun T => ¬ T.Nonempty) = {∅} := by
      ext T
      simp only [mem_filter, mem_powerset, not_nonempty_iff_eq_empty, mem_singleton]
      constructor
      · exact fun h => h.2
      · rintro rfl
        exact ⟨empty_subset _, rfl⟩
    rw [e]
    simp
  have hneg : ∑ T ∈ s.powerset with T.Nonempty, (-1 : ℝ) ^ (#T + 1) =
      -∑ T ∈ s.powerset with T.Nonempty, (-1 : ℝ) ^ #T := by
    rw [← sum_neg_distrib]
    exact sum_congr rfl fun T _ => by ring
  rw [hneg]
  rw [hempty, h] at hsplit
  split_ifs at hsplit ⊢ <;> linarith

/-- **Theorem 3.19**, a variation of the inclusion-exclusion formula:
`μ(⋂ₖ Aₖ - B) = ∑_{T ≠ ∅} (-1)^{|T|+1} μ(⋃_{k ∈ T} Aₖ - B)`. -/
theorem IsSignedMeasure.inf_sdiff_eq_sum [Finite α] {m : Finset α → ℝ} (hm : IsSignedMeasure m)
    {κ : Type*} {s : Finset κ} (hs : s.Nonempty) (A : κ → Finset α)
    (B : Finset α) :
    m (s.inf' hs A \ B) =
      ∑ T ∈ s.powerset with T.Nonempty, (-1 : ℝ) ^ (#T + 1) * m (T.biUnion A \ B) := by
  classical
  have := Fintype.ofFinite α
  have hsum : ∀ X : Finset α, m X = ∑ a, if a ∈ X then m {a} else 0 := fun X => by
    rw [hm.eq_sum_singleton X, sum_ite_mem, univ_inter]
  have hR : ∑ T ∈ s.powerset with T.Nonempty, (-1 : ℝ) ^ (#T + 1) * m (T.biUnion A \ B) =
      ∑ T ∈ s.powerset with T.Nonempty, ∑ a,
        (-1 : ℝ) ^ (#T + 1) * (if a ∈ T.biUnion A \ B then m {a} else 0) :=
    sum_congr rfl fun T _ => by rw [hsum (T.biUnion A \ B), mul_sum]
  rw [hR, hsum (s.inf' hs A \ B), sum_comm]
  refine sum_congr rfl fun a _ => ?_
  by_cases hB : a ∈ B
  · simp [hB]
  -- the indices `k` with `a ∉ Aₖ`
  set P := s.filter fun k => a ∉ A k with hP
  have hT : ∀ T ∈ s.powerset.filter (fun T => T.Nonempty),
      (-1 : ℝ) ^ (#T + 1) * (if a ∈ T.biUnion A \ B then m {a} else 0) =
        m {a} * ((-1 : ℝ) ^ (#T + 1) - if T ⊆ P then (-1 : ℝ) ^ (#T + 1) else 0) := by
    intro T hT
    have hTs : T ⊆ s := mem_powerset.1 (mem_filter.1 hT).1
    have e : a ∈ T.biUnion A \ B ↔ ¬ T ⊆ P := by
      simp only [mem_sdiff, mem_biUnion, hB, not_false_eq_true, and_true, subset_iff, hP,
        mem_filter, not_forall]
      constructor
      · rintro ⟨k, hk, ha⟩
        exact ⟨k, hk, fun h => h.2 ha⟩
      · rintro ⟨k, hk, h⟩
        refine ⟨k, hk, ?_⟩
        by_contra ha
        exact h ⟨hTs hk, ha⟩
    by_cases hTP : T ⊆ P
    · simp [e, hTP]
    · simp [e, hTP, mul_comm]
  rw [sum_congr rfl hT, ← mul_sum, sum_sub_distrib, sum_powerset_nonempty_neg_one_pow]
  have hfilter : ∑ T ∈ s.powerset with T.Nonempty, (if T ⊆ P then (-1 : ℝ) ^ (#T + 1) else 0) =
      ∑ T ∈ P.powerset with T.Nonempty, (-1 : ℝ) ^ (#T + 1) := by
    rw [← sum_filter]
    refine sum_congr ?_ fun _ _ => rfl
    ext T
    simp only [mem_filter, mem_powerset]
    constructor
    · rintro ⟨⟨_, h₁⟩, h₂⟩
      exact ⟨h₂, h₁⟩
    · rintro ⟨h₂, h₁⟩
      exact ⟨⟨h₂.trans (filter_subset _ _), h₁⟩, h₂⟩
  rw [hfilter, sum_powerset_nonempty_neg_one_pow]
  have hsne : s ≠ ∅ := hs.ne_empty
  have hmem : a ∈ s.inf' hs A \ B ↔ P = ∅ := by
    simp only [mem_sdiff, mem_inf', hB, not_false_eq_true, and_true, hP, filter_eq_empty_iff]
    simp
  by_cases hP0 : P = ∅
  · simp [hmem, hP0, hsne]
  · simp [hmem, hP0, hsne]

end SignedMeasure

section NAtom

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The nonempty atoms of the field generated by `X̃ᵢ`, `i ∈ ι`: those of the subsets `S ≠ ∅`. -/
abbrev NAtom (ι : Type*) := {S : Finset ι // S.Nonempty}

/-- **(3.26)** The set `X̃_G = ⋃_{i ∈ G} X̃ᵢ`, as a set of nonempty atoms. -/
def tilde (G : Finset ι) : Finset (NAtom ι) := univ.filter fun a => ¬ Disjoint a.val G

lemma mem_tilde {G : Finset ι} {a : NAtom ι} : a ∈ tilde G ↔ ∃ i ∈ G, i ∈ a.val := by
  simp only [tilde, mem_filter, mem_univ, true_and, not_disjoint_iff]
  exact ⟨fun ⟨i, h₁, h₂⟩ => ⟨i, h₂, h₁⟩, fun ⟨i, h₁, h₂⟩ => ⟨i, h₂, h₁⟩⟩

@[simp] lemma tilde_empty : tilde (∅ : Finset ι) = ∅ := by
  ext a
  simp [mem_tilde]

lemma tilde_union (G G' : Finset ι) : tilde (G ∪ G') = tilde G ∪ tilde G' := by
  ext a
  simp only [mem_union, mem_tilde]
  constructor
  · rintro ⟨i, hi | hi, ha⟩
    · exact Or.inl ⟨i, hi, ha⟩
    · exact Or.inr ⟨i, hi, ha⟩
  · rintro (⟨i, hi, ha⟩ | ⟨i, hi, ha⟩)
    · exact ⟨i, Or.inl hi, ha⟩
    · exact ⟨i, Or.inr hi, ha⟩

/-- **(3.23)** The universal set is the union of the `X̃ᵢ`. -/
@[simp] lemma tilde_univ : tilde (univ : Finset ι) = univ := by
  ext a
  obtain ⟨i, hi⟩ := a.property
  simpa [mem_tilde] using ⟨i, hi⟩

lemma tilde_singleton_eq_baseSet (i : ι) :
    tilde {i} = baseSet (Subtype.val : NAtom ι → Finset ι) i := by
  ext a
  simp [mem_tilde, mem_baseSet]

lemma biUnion_tilde_singleton (T : Finset ι) : T.biUnion (fun i => tilde {i}) = tilde T := by
  ext a
  simp [mem_tilde]

/-- **(3.149)** A nonempty atom is the intersection of the `X̃ᵢ` with `i ∈ S`, minus the union of
the others. -/
theorem singleton_eq_inf_tilde (S : NAtom ι) :
    ({S} : Finset (NAtom ι)) = S.val.inf' S.property (fun i => tilde {i}) \ tilde S.valᶜ := by
  ext a
  simp only [mem_singleton, mem_sdiff, mem_inf', mem_tilde, mem_compl, not_exists, not_and]
  constructor
  · rintro rfl
    exact ⟨fun i hi => ⟨i, rfl, hi⟩, fun i hi hia => hi hia⟩
  · rintro ⟨h₁, h₂⟩
    refine Subtype.ext (Finset.ext fun i => ⟨fun hi => ?_, fun hi => ?_⟩)
    · by_contra hiS
      exact h₂ i hiS hi
    · obtain ⟨j, hj, hja⟩ := h₁ i hi
      rwa [hj] at hja

omit [DecidableEq ι] in
/-- The number of nonempty atoms is `2ⁿ - 1`. -/
theorem card_nAtom : Fintype.card (NAtom ι) = 2 ^ Fintype.card ι - 1 := by
  classical
  rw [Fintype.card_subtype]
  have e : (univ.filter fun S : Finset ι => S.Nonempty) = univ.erase ∅ := by
    ext S
    simp
  rw [e, card_erase_of_mem (mem_univ _), card_univ, Fintype.card_finset]

/-- A function on the nonempty atoms vanishes if its sums on all the sets `X̃_G` vanish. -/
lemma eq_zero_of_sum_tilde_eq_zero {u : NAtom ι → ℝ}
    (h : ∀ G : Finset ι, G.Nonempty → ∑ a ∈ tilde G, u a = 0) : u = 0 := by
  have htotal : ∑ a, u a = 0 := by
    rcases isEmpty_or_nonempty ι with hι | hι
    · have : IsEmpty (NAtom ι) := ⟨fun a => by
        obtain ⟨i, _⟩ := a.property
        exact isEmptyElim i⟩
      simp
    · rw [← h univ univ_nonempty, tilde_univ]
  have hsub : ∀ W : Finset ι, ∑ a ∈ univ.filter (fun a : NAtom ι => a.val ⊆ W), u a = 0 := by
    intro W
    have hsplit := sum_filter_add_sum_filter_not (univ : Finset (NAtom ι)) (fun a => a.val ⊆ W) u
    rcases eq_or_ne W univ with rfl | hW
    · simpa using htotal
    · have hne : (Wᶜ).Nonempty := by
        rw [← ne_empty_iff_nonempty, Ne, compl_eq_empty_iff]
        exact hW
      have e : (univ.filter fun a : NAtom ι => ¬ a.val ⊆ W) = tilde Wᶜ := by
        ext a
        simp only [mem_filter, mem_univ, true_and, mem_tilde, mem_compl, subset_iff, not_forall]
        constructor
        · rintro ⟨i, hi, hiW⟩
          exact ⟨i, hiW, hi⟩
        · rintro ⟨i, hiW, hi⟩
          exact ⟨i, hi, hiW⟩
      rw [e, h _ hne, htotal, add_zero] at hsplit
      exact hsplit
  have key : ∀ (S : Finset ι) (hS : S.Nonempty), u ⟨S, hS⟩ = 0 := by
    intro S
    induction S using Finset.strongInduction with
    | H S ih =>
      intro hS
      have h₀ := hsub S
      rwa [sum_eq_single_of_mem (⟨S, hS⟩ : NAtom ι) (by simp) fun b hb hne => ?_] at h₀
      have hb' : b.val ⊆ S := (mem_filter.1 hb).2
      have hss : b.val ⊂ S := hb'.ssubset_of_ne fun e => hne (Subtype.ext e)
      exact ih b.val hss b.property
  funext a
  exact key a.val a.property

/-- **Theorem 3.6.** A signed measure on the field is completely specified by its values on the sets
`X̃_G`, `G ≠ ∅`, and these can be any real numbers. -/
theorem existsUnique_isSignedMeasure_tilde (h : Finset ι → ℝ) :
    ∃! m : Finset (NAtom ι) → ℝ,
      IsSignedMeasure m ∧ ∀ G : Finset ι, G.Nonempty → m (tilde G) = h G := by
  -- the map `u ↦ (∑_{a ∈ X̃_G} u a)_G` of (3.27), from the values on the atoms
  let C : (NAtom ι → ℝ) →ₗ[ℝ] (NAtom ι → ℝ) :=
    { toFun := fun u G => ∑ a ∈ tilde G.val, u a
      map_add' := fun u v => by
        funext G
        simp [sum_add_distrib]
      map_smul' := fun c u => by
        funext G
        simp [mul_sum] }
  have hinj : Function.Injective C := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro u hu
    refine eq_zero_of_sum_tilde_eq_zero fun G hG => ?_
    exact congrFun hu ⟨G, hG⟩
  obtain ⟨u, hu⟩ := (LinearMap.injective_iff_surjective.1 hinj) fun G => h G.val
  refine ⟨fun A => ∑ a ∈ A, u a, ⟨isSignedMeasure_sum u, fun G hG => congrFun hu ⟨G, hG⟩⟩, ?_⟩
  rintro m ⟨hm, hmh⟩
  funext A
  rw [hm.eq_sum_singleton A]
  refine sum_congr rfl fun a _ => ?_
  have : (fun a => m {a}) = u := by
    apply hinj
    funext G
    change ∑ a ∈ tilde G.val, m {a} = (C u) G
    rw [← hm.eq_sum_singleton, hmh _ G.property, hu]
  exact congrFun this a

/-- The value on the nonempty atom `S` of the signed measure with `μ(X̃_G) = h G`, by (3.29) and
Theorem 3.19. -/
def atomValue (h : Finset ι → ℝ) (S : Finset ι) : ℝ :=
  ∑ T ∈ S.powerset with T.Nonempty, (-1 : ℝ) ^ (#T + 1) * (h (T ∪ Sᶜ) - h Sᶜ)

/-- **Appendix 3.A.** The value of a signed measure on a nonempty atom is a linear combination of
its values on the sets `X̃_G`. -/
theorem IsSignedMeasure.singleton_eq_atomValue {m : Finset (NAtom ι) → ℝ}
    (hm : IsSignedMeasure m) (S : NAtom ι) :
    m {S} = atomValue (fun G => m (tilde G)) S.val := by
  rw [singleton_eq_inf_tilde, hm.inf_sdiff_eq_sum, atomValue]
  refine sum_congr rfl fun T _ => ?_
  rw [biUnion_tilde_singleton, hm.sdiff_eq, tilde_union]

/-- The signed measure with the values `h G` on the sets `X̃_G`. -/
def signedMeasureOf (h : Finset ι → ℝ) (A : Finset (NAtom ι)) : ℝ :=
  ∑ a ∈ A, atomValue h a.val

/-- `signedMeasureOf h` is a signed measure. -/
theorem isSignedMeasure_signedMeasureOf (h : Finset ι → ℝ) : IsSignedMeasure (signedMeasureOf h) :=
  isSignedMeasure_sum _

/-- `signedMeasureOf h` is the unique signed measure with the values `h G` on the sets `X̃_G`,
if `h ∅ = 0`, as it has to be. -/
theorem signedMeasureOf_tilde {h : Finset ι → ℝ} (h0 : h ∅ = 0) (G : Finset ι) :
    signedMeasureOf h (tilde G) = h G := by
  obtain ⟨m, ⟨hm, hmh⟩, -⟩ := existsUnique_isSignedMeasure_tilde h
  have hval : (fun G => m (tilde G)) = h := by
    funext G
    rcases G.eq_empty_or_nonempty with rfl | hG
    · simp [h0, hm.map_empty]
    · exact hmh G hG
  have hall : signedMeasureOf h = m := by
    funext A
    rw [hm.eq_sum_singleton A, signedMeasureOf]
    refine sum_congr rfl fun a _ => ?_
    rw [hm.singleton_eq_atomValue, hval]
  rw [hall]
  exact congrFun hval G

/-- A signed measure with the values `h G` on the sets `X̃_G`, `G ≠ ∅`, is `signedMeasureOf h`. -/
theorem IsSignedMeasure.eq_signedMeasureOf {h : Finset ι → ℝ} (h0 : h ∅ = 0)
    {m : Finset (NAtom ι) → ℝ} (hm : IsSignedMeasure m)
    (hmh : ∀ G : Finset ι, G.Nonempty → m (tilde G) = h G) : m = signedMeasureOf h :=
  (existsUnique_isSignedMeasure_tilde h).unique ⟨hm, hmh⟩
    ⟨isSignedMeasure_signedMeasureOf h, fun G _ => signedMeasureOf_tilde h0 G⟩

end NAtom

end InfoTheory
